# Required — Google AI Studio API key for Gemini models
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Optional — Groq API key (fallback LLM if Gemini is unavailable)
GROQ_API_KEY=your_groq_api_key

# Required for production — Supabase PostgreSQL connection string (IPv4 pooler)
# Without this, the backend falls back to local ChromaDB for development
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional — Connection pool settings
DB_POOL_MAX_SIZE=8

# Optional — Set to 'production' in deployed environments
APP_ENV=development

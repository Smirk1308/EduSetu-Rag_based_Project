# Gemini API key (optional; primary provider)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (optional fallback; get one from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Production document store. Keep this server-only; never prefix with NEXT_PUBLIC_.
# Use the Supabase Session Pooler or direct PostgreSQL connection for the FastAPI service.
DATABASE_URL=postgresql://postgres:your-password@your-db-host:5432/postgres
DB_POOL_MAX_SIZE=8
